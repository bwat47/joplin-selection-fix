{
    "$schema": "./node_modules/fallow/schema.json",
    "entry": ["src/contentScript/selectionFix.ts"],
    "supportEntry": ["src/**/*.test.ts"],
    "ignorePatterns": ["**/*.d.ts", "api/**", "src/logger.ts"],
    "rules": {
        "complexity-crap": "off",
        "dev-dependencies-in-production": "off"
    },
    "health": {
        "ignore": ["src/**/*.test.ts"],
        "maxCognitive": 15,
        "maxCyclomatic": 20
    }
}
